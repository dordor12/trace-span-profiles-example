# =============================================================================
# Trace-Span-Profiles Example Configuration
# =============================================================================
# Copy this file to .env and customize for your local setup
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Images
# -----------------------------------------------------------------------------
# Override these to use custom/local images

PYROSCOPE_IMAGE=grafana/pyroscope:latest
TEMPO_IMAGE=grafana/tempo:2.7.0
GRAFANA_IMAGE=grafana/grafana:11.3.0
OTEL_AGENT_IMAGE=otel/opentelemetry-java-instrumentation:2.12.0

# -----------------------------------------------------------------------------
# Local Development Paths (Optional)
# -----------------------------------------------------------------------------
# Set these to use locally built jars instead of published Maven artifacts
# Leave empty to use the published versions specified below

# Path to local otel-profiling-java repo (builds pyroscope-otel.jar)
# Example: /home/user/otel-profiling-java
OTEL_PROFILING_JAVA_PATH=

# Path to local pyroscope-java repo (builds pyroscope.jar agent)
# Example: /home/user/pyroscope-java
PYROSCOPE_JAVA_PATH=

# -----------------------------------------------------------------------------
# Direct JAR Paths (Alternative to repo paths)
# -----------------------------------------------------------------------------
# Use these if you want to specify jar files directly instead of repo paths

# Path to pyroscope-otel.jar
# Example: /home/user/jars/pyroscope-otel.jar
PYROSCOPE_OTEL_JAR=

# Path to pyroscope.jar (agent)
# Example: /home/user/jars/pyroscope.jar
PYROSCOPE_AGENT_JAR=

# -----------------------------------------------------------------------------
# Published Artifact Versions
# -----------------------------------------------------------------------------
# Used when local paths are not set (downloads from Maven Central)

PYROSCOPE_AGENT_VERSION=2.1.2
PYROSCOPE_OTEL_VERSION=1.0.4
OTEL_JAVA_AGENT_VERSION=2.12.0

# -----------------------------------------------------------------------------
# Profiling Configuration
# -----------------------------------------------------------------------------

# Profiling event type: wall, cpu, alloc, lock
PROFILING_EVENT=wall

# Sampling interval (e.g., 1ms, 10ms, 100ms)
PROFILING_INTERVAL=10ms

# Upload interval to Pyroscope server
UPLOAD_INTERVAL=10s

# Allocation profiling interval in bytes
PROFILING_ALLOC=10000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable profiling context propagation between threads (recommended: true)
OTEL_PYROSCOPE_CONTEXT_PROPAGATION_ENABLED=true

# Only profile root spans (set to false to profile all spans)
OTEL_PYROSCOPE_ROOT_SPAN_ONLY=false

# Include span names in profiling data
OTEL_PYROSCOPE_ADD_SPAN_NAME=true

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------

# Application name shown in Pyroscope
APP_NAME=demo-app

# Service name for OpenTelemetry
OTEL_SERVICE_NAME=demo-app
